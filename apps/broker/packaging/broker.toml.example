# /etc/plank-broker/broker.toml  (root:plank-broker 0640)
# Example values use reserved names; see README.md for the full layout.

listen = "0.0.0.0:29000"
# Returned as `endpoint` when a request carries no usable Host header.
public_endpoint = "remote.example.org"

[tls]
cert = "/etc/plank-broker/tls.crt"   # clients pin the SPKI: `plank-broker spki /etc/plank-broker/tls.crt`
key = "/etc/plank-broker/tls.key"    # plank-broker:root 0400

[kerberos]
realm = "EXAMPLE.ORG"
principal = "HTTP/broker.example.org@EXAMPLE.ORG"
keytab = "/etc/plank-broker/broker.keytab"  # plank-broker:root 0400
host_service = "plank"                      # hosts are plank/<fqdn>@REALM (auth-ind otp)
ticket_lifetime_secs = 36000
session_dir = "/var/lib/plank-broker/sessions"  # device-bound sessions (records + FILE: ccaches)

[ldap]
uris = ["ldaps://ipa1.example.org:636", "ldaps://ipa2.example.org:636"]  # ldap:// = StartTLS
ca_cert = "/etc/plank-broker/ca.crt"        # the directory CA (FreeIPA: /etc/ipa/ca.crt)
# base_dn = "dc=example,dc=org"            # default: derived from the realm
hostgroup = "plank-remote"                  # only these hosts are listed / relayed to
hbac_service = "plank-remote"               # explicit HBAC rules for this service assign hosts
cache_ttl_secs = 60
timeout_secs = 5

[hosts]
port = 28989
probe_interval_secs = 15
probe_timeout_secs = 3
pins_file = "/var/lib/plank-broker/pins.json"

[relay]
socket = "/run/plank-broker/relay.sock"
port_min = 29001
port_max = 29100
lease_initial_secs = 30
lease_keepalive_secs = 90
api_user = "plank-broker"
allowed_target_cidrs = ["192.0.2.0/24"]      # workstation network(s); relay refuses anything else
table = "plank_broker"
nft = "/usr/sbin/nft"
conntrack = "/usr/sbin/conntrack"

# Office clients: requests from these networks get the host itself from `connect`
# (route "direct", no relay lease). Private networks only. Default: relay everyone.
# [routing]
# direct_client_cidrs = ["10.0.0.0/24"]

[limits]
starts_per_minute_per_ip = 5
failures_per_user_ip = 3
failures_per_ip = 10
block_secs = 900
global_failure_burst_per_minute = 20
conversation_ttl_secs = 120
session_absolute_secs = 36000
session_idle_secs = 3600
max_sessions = 500
max_conversations = 1000
max_connections = 256
min_respond_ms = 1500
device_session_absolute_secs = 0        # never expire a device-bound login by age
device_session_idle_secs = 0            # never expire it for inactivity
renew_before_secs = 7200
device_proof_skew_secs = 60

# Passkey sign-in (auth/start with method "passkey"). Needs the SSSD client
# plugin on this host (package sssd-passkey). Defaults shown.
# [passkey]
# rp_id = "example.org"             # default: the realm in lower case (the IPA domain)
# max_pending = 32                  # waiting passkey conversations; beyond this auth/start answers 429
# challenge_timeout_secs = 10       # wait for the KDC challenge, then answer with a synthetic one

# First sign-in and 2FA enrolment: /v1/enroll/*; docs/fernweh/broker.md.
# The broker only READS the gates as its own principal; the password change, the TOTP
# token and a passkey mapping are written as the user (self-service ACIs). Defaults shown.
# [enrol]
# enabled = true                         # false: every /v1/enroll/* answers 404
# group = "fernweh"                      # G1: only members may enrol
# excluded_groups = ["admins", "sysadmins"]  # G2: these onboard in the studio
# window_days = 0                        # G4: 0 disables password age limit
# daily_cap = 5                          # password proofs per user per 24 h (any address)
# issuer = "BDE Fernweh"                 # label in the authenticator app
# ldap_uris = ["ldaps://ipa1.example.org:636"]  # binds as the user; default: ldap.uris
# conversation_ttl_secs = 600
# max_code_attempts = 5
# max_password_attempts = 5
# fallback_min_length = 8                # policy shown when cn=global_policy is not readable
# fallback_min_classes = 0

# Optional update feeds. Leave absent for source-only deployments. Enabling the
# Client's FERNWEH_UPDATES_ENABLED also requires this explicitly managed service.
# [client_updates]
# directory = "/var/lib/plank-broker/client-updates/macos-arm64"
# windows_directory = "/var/lib/plank-broker/client-updates/windows-x64"

# Shared Mac admission is separately opt-in; see protocol/macos-broker-admission.md.
# [mac_admission]
# signing_key_file = "/etc/plank-broker/mac-admission-key.der"
# ttl_secs = 30
# [mac_admission.hosts]
# "mac.example.org" = "artist"

# ---------------------------------------------------------------------------
# Active Directory. This block is a COMPLETE alternative config:
# copy it to broker.toml and remove the leading "# ". It replaces every section
# above (FreeIPA). See docs/fernweh/broker.md, "Active Directory".
# ---------------------------------------------------------------------------
# --- AD BEGIN
# listen = "0.0.0.0:29000"
# public_endpoint = "plank.example.org"        # the public DNS name of the forwarded IP
#
# [directory]
# backend = "ad"
#
# [tls]
# cert = "/etc/plank-broker/tls.crt"
# key = "/etc/plank-broker/tls.key"
#
# [kerberos]
# realm = "EXAMPLE.ORG"
# # The broker VM's machine account from `adcli join` (default keytab entry NAME$).
# principal = "BROKER$@EXAMPLE.ORG"
# keytab = "/etc/plank-broker/broker.keytab"
# password_only = true                         # plain password AS-REQ, no OTP list, no FAST
# # Every login's TGT is verified against this keytab entry (krb5_verify_init_creds), so a
# # spoofed KDC cannot accept arbitrary passwords. Use host/<broker fqdn>.
# verify_principal = "host/broker.example.org@EXAMPLE.ORG"
# login_timeout_secs = 10                      # default; how long a sign-in waits for the KDC
# ticket_lifetime_secs = 36000
# session_dir = "/var/lib/plank-broker/sessions"
#
# [ldap]
# # The host name must be the DC's FQDN (it names ldap/<fqdn> and the certificate CN).
# # If DNS cannot resolve it, add the DC's address for that name to /etc/hosts.
# uris = ["ldaps://dc1.example.org:636"]
# ca_cert = "/etc/plank-broker/ad-ca.pem"      # root of the internal CA (signed the DC certificate)
# # base_dn = "dc=example,dc=org"            # default: derived from the realm
# cache_ttl_secs = 60
# timeout_secs = 5
#
# [ad]
# hosts_group = "PLANK-Hosts"                  # computer group: the PLANK host inventory
# access_group_prefix = "PLANK-"               # per-host access group: PLANK-<COMPUTERNAME>
# all_hosts_group = "PLANK-AllHosts"           # members reach every host
# # user_base = "OU=Staff,DC=example,DC=org"
# computer_base = "OU=Workstations,DC=example,DC=org"
# groups_base = "OU=PLANK,OU=Groups,DC=example,DC=org"   # REQUIRED: only security groups in this OU count
# # The domain's lockout policy (for example, 5 bad passwords, 30 min observation window,
# # 30 min lockout). REQUIRED: the broker keeps its own per-user counter that mirrors AD's
# # (reset only W + margin after the LAST failure) and refuses limits that could reach it.
# lockout_threshold = 5
# lockout_window_secs = 1800
# lockout_margin_secs = 60                     # default; added to the window
# # [ad.host_ipv4]                             # optional: skip DNS for a host
# # "ws01.example.org" = "192.0.2.51"
#
# [hosts]
# port = 28989
# probe_mode = "tls"                           # TLS 1.3 handshake, no client certificate
# admission = "none"                           # hosts sign the user in themselves; empty gssapi_token
# # Optional static certificate pins (SHA-256 of the leaf certificate DER); such a
# # host is never TOFU-pinned:
# # [hosts.static_pins]
# # "ws01.example.org" = "<64 hex digits>"
# pins_file = "/var/lib/plank-broker/pins.json"
#
# [relay]
# socket = "/run/plank-broker/relay.sock"
# port_min = 29001
# port_max = 29100
# allowed_target_cidrs = ["192.0.2.0/24"]      # the workstation network
#
# [limits]
# failures_per_user_ip = 3
# failures_per_ip = 10
# # Wrong passwords per user from ANY address per quiet period (AD window + margin),
# # counted before the KDC is asked. Must be below the AD lockout threshold.
# failures_per_user = 3
# block_secs = 900                             # per-IP blocks only; the per-user rule is the AD model
# min_respond_ms = 1500
#
# [enrol]
# enabled = false                              # enrolment and passkeys are FreeIPA only
# --- AD END
